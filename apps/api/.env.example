DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters"
PORT=4000
CLIENT_URL="http://localhost:5173"
NODE_ENV="development"
AUTH_SESSION_TTL_HOURS=24

# Optional Cloudinary credentials; uploads are handled by the API.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Optional email delivery.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# Local-only demo seed; requires explicit opt-in and CLI confirmation.
ALLOW_DEMO_SEED=false
DEMO_SEED_PASSWORD=""

# Dedicated test target; for an isolated schema in the same Supabase project,
# add ?schema=marketplace_test to both URLs. Never use the production schema.
TEST_DATABASE_URL=""
TEST_DIRECT_URL=""
E2E_STAFF_EMAIL=""
E2E_STAFF_PASSWORD=""
